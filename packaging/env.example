# OpenVox GUI configuration reference.
#
# The live file is /opt/openvox-gui/config/.env, generated by
# `openvox-gui-setup` (root-only: it contains the app secret key). Every
# value can also be overridden via OPENVOX_GUI_-prefixed environment
# variables. This example shows the defaults for an all-in-one host.

OPENVOX_GUI_APP_NAME="OpenVox GUI"
OPENVOX_GUI_APP_HOST=0.0.0.0
OPENVOX_GUI_APP_PORT=4567
OPENVOX_GUI_DEBUG=false
#OPENVOX_GUI_SECRET_KEY=<generated>
OPENVOX_GUI_UVICORN_WORKERS=2

OPENVOX_GUI_PUPPET_SERVER_HOST=puppet.example.com
OPENVOX_GUI_PUPPET_SERVER_PORT=8140
OPENVOX_GUI_PUPPET_CA_HOST=
OPENVOX_GUI_PUPPET_CA_PORT=
OPENVOX_GUI_PUPPET_SSL_CERT=/etc/puppetlabs/puppet/ssl/certs/puppet.example.com.pem
OPENVOX_GUI_PUPPET_SSL_KEY=/etc/puppetlabs/puppet/ssl/private_keys/puppet.example.com.pem
OPENVOX_GUI_PUPPET_SSL_CA=/etc/puppetlabs/puppet/ssl/certs/ca.pem
OPENVOX_GUI_PUPPET_CONFDIR=/etc/puppetlabs/puppet
OPENVOX_GUI_PUPPET_CODEDIR=/etc/puppetlabs/code

OPENVOX_GUI_SSL_ENABLED=false
OPENVOX_GUI_SSL_CERT_PATH=/etc/puppetlabs/puppet/ssl/certs/puppet.example.com.pem
OPENVOX_GUI_SSL_KEY_PATH=/etc/puppetlabs/puppet/ssl/private_keys/puppet.example.com.pem

OPENVOX_GUI_PUPPETDB_HOST=puppet.example.com
OPENVOX_GUI_PUPPETDB_PORT=8081

OPENVOX_GUI_AUTH_BACKEND=local

OPENVOX_GUI_DATABASE_URL=sqlite+aiosqlite:////opt/openvox-gui/data/openvox_gui.db
