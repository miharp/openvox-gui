#!/bin/bash
# Shipped by the openvox-gui package.
#
# One-time site setup for a package-installed OpenVox GUI: generates
# /opt/openvox-gui/config/.env, applies the sudoers rules and SELinux
# port context, enables and starts the service, and creates the initial
# admin user. Installing the package alone changes no configuration;
# this command is the moral equivalent of install.sh's configure steps
# and accepts the same answer-file keys via -c.
#
# Usage: openvox-gui-setup -c /path/to/answers.conf
#        openvox-gui-setup            (defaults for an all-in-one host)
set -euo pipefail

INSTALL_DIR="/opt/openvox-gui"

# ── Defaults (same keys and semantics as install.sh / install.conf) ──
APP_HOST="0.0.0.0"
APP_PORT="4567"
APP_DEBUG="false"
UVICORN_WORKERS="2"
PUPPET_SERVER_HOST="$(hostname -f)"
PUPPET_SERVER_PORT="8140"
PUPPET_CA_HOST=""
PUPPET_CA_PORT="8140"
PUPPETDB_HOST="$(hostname -f)"
PUPPETDB_PORT="8081"
PUPPET_CONFDIR="/etc/puppetlabs/puppet"
PUPPET_CODEDIR="/etc/puppetlabs/code"
PUPPET_SSL_CERT="${PUPPET_CONFDIR}/ssl/certs/$(hostname -f).pem"
PUPPET_SSL_KEY="${PUPPET_CONFDIR}/ssl/private_keys/$(hostname -f).pem"
PUPPET_SSL_CA="${PUPPET_CONFDIR}/ssl/certs/ca.pem"
SSL_ENABLED="false"
SSL_CERT_PATH="${PUPPET_SSL_CERT}"
SSL_KEY_PATH="${PUPPET_SSL_KEY}"
AUTH_BACKEND="local"
ADMIN_USERNAME="admin"
ADMIN_PASSWORD=""
SERVICE_USER="puppet"
SERVICE_GROUP="puppet"
CONFIGURE_SELINUX="auto"
HTTP_PROXY="${HTTP_PROXY:-}"
HTTPS_PROXY="${HTTPS_PROXY:-}"
NO_PROXY="${NO_PROXY:-}"

CONF_FILE=""
while [ $# -gt 0 ]; do
  case "$1" in
    -c) CONF_FILE="$2"; shift 2 ;;
    -h|--help) grep '^#' "$0" | sed 's/^# \?//' | head -12; exit 0 ;;
    *) echo "Unknown argument: $1" >&2; exit 2 ;;
  esac
done

if [ -n "$CONF_FILE" ]; then
  [ -f "$CONF_FILE" ] || { echo "Config file not found: $CONF_FILE" >&2; exit 1; }
  # shellcheck disable=SC1090
  source "$CONF_FILE"
fi

if [ "$(id -u)" -ne 0 ]; then
  echo "openvox-gui-setup must run as root" >&2
  exit 1
fi

VENV_PY="${INSTALL_DIR}/venv/bin/python3"
[ -x "$VENV_PY" ] || { echo "No virtualenv at ${INSTALL_DIR}/venv — is the openvox-gui package installed?" >&2; exit 1; }

VERSION=$(cat "${INSTALL_DIR}/VERSION" 2>/dev/null || echo "unknown")
SECRET_KEY=$("$VENV_PY" -c 'import secrets; print(secrets.token_hex(32))')

# ── config/.env (same content install.sh generates) ──────────────────
cat > "${INSTALL_DIR}/config/.env" << ENVEOF
# OpenVox GUI Configuration — generated by openvox-gui-setup (package v${VERSION})
# All values can be overridden with OPENVOX_GUI_ prefix environment variables

# Application
OPENVOX_GUI_APP_NAME="OpenVox GUI"
OPENVOX_GUI_APP_HOST=${APP_HOST}
OPENVOX_GUI_APP_PORT=${APP_PORT}
OPENVOX_GUI_DEBUG=${APP_DEBUG}
OPENVOX_GUI_SECRET_KEY=${SECRET_KEY}
OPENVOX_GUI_UVICORN_WORKERS=${UVICORN_WORKERS}

# PuppetServer — catalog compile endpoint (compiler VIP in clustered estates)
OPENVOX_GUI_PUPPET_SERVER_HOST=${PUPPET_SERVER_HOST}
OPENVOX_GUI_PUPPET_SERVER_PORT=${PUPPET_SERVER_PORT}
# CA VIP when different from compiler VIP (clustered / dedicated console). Leave empty if co-located.
OPENVOX_GUI_PUPPET_CA_HOST=${PUPPET_CA_HOST}
OPENVOX_GUI_PUPPET_CA_PORT=${PUPPET_CA_PORT}
OPENVOX_GUI_PUPPET_SSL_CERT=${PUPPET_SSL_CERT}
OPENVOX_GUI_PUPPET_SSL_KEY=${PUPPET_SSL_KEY}
OPENVOX_GUI_PUPPET_SSL_CA=${PUPPET_SSL_CA}
OPENVOX_GUI_PUPPET_CONFDIR=${PUPPET_CONFDIR}

# GUI SSL (incoming)
OPENVOX_GUI_SSL_ENABLED=${SSL_ENABLED}
OPENVOX_GUI_SSL_CERT_PATH=${SSL_CERT_PATH}
OPENVOX_GUI_SSL_KEY_PATH=${SSL_KEY_PATH}
OPENVOX_GUI_PUPPET_CODEDIR=${PUPPET_CODEDIR}

# PuppetDB
OPENVOX_GUI_PUPPETDB_HOST=${PUPPETDB_HOST}
OPENVOX_GUI_PUPPETDB_PORT=${PUPPETDB_PORT}

# Authentication (none | local)
OPENVOX_GUI_AUTH_BACKEND=${AUTH_BACKEND}

# Database (sqlite default)
OPENVOX_GUI_DATABASE_URL=sqlite+aiosqlite:///${INSTALL_DIR}/data/openvox_gui.db

# Proxy Settings
OPENVOX_GUI_HTTP_PROXY=${HTTP_PROXY}
OPENVOX_GUI_HTTPS_PROXY=${HTTPS_PROXY}
OPENVOX_GUI_NO_PROXY=${NO_PROXY}
ENVEOF
chmod 600 "${INSTALL_DIR}/config/.env"
chown "${SERVICE_USER}:${SERVICE_GROUP}" "${INSTALL_DIR}/config/.env"
echo "Generated ${INSTALL_DIR}/config/.env"

# ── sudoers rules (delegated to the application's own script) ────────
if [ -x "${INSTALL_DIR}/scripts/ensure-sudoers.sh" ] && [ -d /etc/sudoers.d ]; then
  SERVICE_USER="$SERVICE_USER" INSTALL_DIR="$INSTALL_DIR" \
    PUPPET_SERVER_HOST="$PUPPET_SERVER_HOST" \
    bash "${INSTALL_DIR}/scripts/ensure-sudoers.sh" || \
    echo "Warning: sudoers setup failed; orchestration features may be limited" >&2
else
  echo "Warning: sudo not installed (/etc/sudoers.d missing) — skipping sudoers rules" >&2
fi

# ── SELinux port context (RedHat family, when tooling is present) ────
if [ "$CONFIGURE_SELINUX" != "false" ] && command -v semanage >/dev/null 2>&1; then
  semanage port -a -t http_port_t -p tcp "$APP_PORT" 2>/dev/null || \
    semanage port -m -t http_port_t -p tcp "$APP_PORT" 2>/dev/null || true
  echo "Configured SELinux port context for ${APP_PORT}/tcp"
fi

# ── Enable + start, wait for health ──────────────────────────────────
systemctl enable --now openvox-gui

SCHEME="http"; [ "$SSL_ENABLED" = "true" ] && SCHEME="https"
echo "Waiting for the service to answer on ${SCHEME}://127.0.0.1:${APP_PORT}/health ..."
HEALTH_OK="false"
for _ in $(seq 1 30); do
  if "$VENV_PY" -c "
import ssl, urllib.request, sys
ctx = ssl.create_default_context(); ctx.check_hostname = False; ctx.verify_mode = ssl.CERT_NONE
urllib.request.urlopen('${SCHEME}://127.0.0.1:${APP_PORT}/health', context=ctx, timeout=3)
" 2>/dev/null; then HEALTH_OK="true"; break; fi
  sleep 2
done
if [ "$HEALTH_OK" != "true" ]; then
  echo "Service did not become healthy. Check: journalctl -u openvox-gui -n 50" >&2
  exit 1
fi
echo "Service is healthy."

# ── Initial admin user (local auth) ──────────────────────────────────
if [ "$AUTH_BACKEND" = "local" ]; then
  if [ -z "$ADMIN_PASSWORD" ]; then
    ADMIN_PASSWORD=$("$VENV_PY" -c 'import secrets, string; print("".join(secrets.choice(string.ascii_letters + string.digits) for _ in range(16)))')
  fi
  cd "${INSTALL_DIR}"
  "$VENV_PY" -c "
import sys, asyncio
sys.path.insert(0, '${INSTALL_DIR}/backend')
from app.middleware.auth_local import add_user
try:
    asyncio.run(add_user('${ADMIN_USERNAME}', '${ADMIN_PASSWORD}', 'admin'))
    print('Admin user created.')
except Exception as e:
    if 'already exists' in str(e).lower() or 'unique' in str(e).lower():
        print('Admin user already exists — skipping.')
    else:
        raise
"
  cat > "${INSTALL_DIR}/config/.credentials" << CREDEOF
# OpenVox GUI Admin Credentials
# DELETE THIS FILE after noting the password!
Username: ${ADMIN_USERNAME}
Password: ${ADMIN_PASSWORD}
CREDEOF
  chmod 600 "${INSTALL_DIR}/config/.credentials"
  chown "${SERVICE_USER}:${SERVICE_GROUP}" "${INSTALL_DIR}/config/.credentials"
  echo "Credentials saved to ${INSTALL_DIR}/config/.credentials"
fi

echo "OpenVox GUI is ready: ${SCHEME}://${PUPPET_SERVER_HOST}:${APP_PORT}"
